# Entorno virtual
.venv/
venv/
ENV/

# Archivos compilados y caché de Python
__pycache__/
*.py[cod]
*.pyo
*.pyc

# Archivos de distribución / PyInstaller / Executables
dist/
build/
*.spec

# Archivos y carpetas de datos
data/
*.xlsx
*.xls
*.csv
*.log
config.json

# Excepciones: Mantener estructura de carpetas en Git
!data/
!data/Descargas/
!data/Logs/
!data/Backups/
!data/.gitkeep
!data/Descargas/.gitkeep
!data/Logs/.gitkeep
!data/Backups/.gitkeep

# Excepciones: Asegurar carpeta de Assets e imágenes
!assets/
!assets/*
!assets/**/*.png
!assets/**/*.ico

# Archivos temporales de PostScript / Impresoras (ignorar temp.ps)
assets/temp.ps
*.ps

# macOS / Sistema
.DS_Store

# IDEs
.vscode/
.idea/